{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "build",
        "command": "dotnet",
        "type": "process",
        "args": [
            "build",
            "${workspaceFolder}/Jellyfin.Plugin.AppleMusic.slnx",
            "/property:GenerateFullPaths=true",
            "/consoleloggerparameters:NoSummary;ForceNoAlign"
        ],
        "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Jellyfin.Plugin.AppleMusic.slnx"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "deploy: jellyfin 12.0",
      "type": "shell",
      "command": "./scripts/deploy.sh",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "deploy: jellyfin 10.11",
      "type": "shell",
      "command": "./scripts/deploy.sh --legacy",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "jellyfin: logs",
      "type": "shell",
      "command": "docker logs -f --tail 200 applemusic-jellyfin",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "package",
      "type": "shell",
      "command": "./scripts/package.sh",
      "problemMatcher": []
    },
    {
        "label": "publish",
        "command": "dotnet",
        "type": "process",
        "args": [
            "publish",
            "${workspaceFolder}/Jellyfin.Plugin.AppleMusic.slnx",
            "/property:GenerateFullPaths=true",
            "/consoleloggerparameters:NoSummary;ForceNoAlign"
        ],
        "problemMatcher": "$msCompile"
    },
    {
        "label": "watch",
        "command": "dotnet",
        "type": "process",
        "args": [
            "watch",
            "run",
            "--project",
            "${workspaceFolder}/Jellyfin.Plugin.AppleMusic.slnx"
        ],
        "problemMatcher": "$msCompile"
    }
  ]
}
